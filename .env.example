# URL de l'API, sans slash final ni /api/v1.
# En local : http://localhost:3000 (Vite proxy, pas besoin de CORS).
# Netlify / prod : URL Render, ex. https://cinemax-api-xc50.onrender.com
# CORS_ORIGINS de l’API doit contenir l’origine du front (https://….netlify.app).
VITE_API_URL=http://localhost:3000

# Clé publique Stripe (pk_test_… / pk_live_…). Obligatoire pour le checkout.
VITE_STRIPE_PUBLISHABLE_KEY=
